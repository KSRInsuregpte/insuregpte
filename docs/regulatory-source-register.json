  "review_policy": {
    "controlling_source_order": [
      "current official examination handbook",
      "current official syllabus or credit-point notice",
      "subject-specific official amendment or withdrawal notice",
      "session-specific official timetable and centre list"
    ],
    "filename_dates_are_authoritative": false,
    "full_study_material_may_be_republished": false,
    "session_documents_must_expire": true,
    "sale_requires_reviewed_learning_content": true,
    "amendment_process": [
      "record the official amendment and its printed date",
      "map the amendment to the affected subject and base edition",
      "review affected lessons and questions",
      "publish a reviewed content version",
      "retain the previous version for audit"
    ]
  },
